---
/**
 * Embeds the archify-generated layered architecture diagram, kept in sync
 * with the docs theme. The viewer accepts ?theme=light|dark and ?embed=1.
 */
const diagram = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}diagrams/sparrow-layered-architecture.html`;
---

<iframe
  id="layered-arch-frame"
  data-diagram={diagram}
  title="Sparrow layered architecture: client and embedded UI through middleware, REST handlers, the webhook service, the store/PostgreSQL repository layer, River queue workers (EventWorker, WebhookWorker, BatchJobWorker), and the signing HTTP client to external endpoints."
  loading="lazy"
></iframe>

<script>
  const frame = document.getElementById('layered-arch-frame') as HTMLIFrameElement;
  const base = frame.dataset.diagram;
  const src = (theme: string) => `${base}?embed=1&theme=${theme}`;
  const current = () =>
    document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  frame.src = src(current());
  new MutationObserver(() => {
    const next = new URL(src(current()), location.origin).href;
    if (frame.src !== next) frame.src = next;
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>

<style>
  #layered-arch-frame {
    width: 100%;
    height: 72vh;
    min-height: 560px;
    border: 1px solid var(--sp-outline-variant);
    border-radius: 8px;
    background: var(--sp-surface-container-lowest);
  }
</style>
