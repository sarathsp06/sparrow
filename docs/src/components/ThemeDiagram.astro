---
/**
 * ThemeDiagram — renders a diagram with light and dark variants.
 * custom.css shows exactly one variant based on [data-theme].
 *
 * Usage:
 *   import ThemeDiagram from '../../components/ThemeDiagram.astro';
 *   <ThemeDiagram light={lightSvg} dark={darkSvg} alt="Description" />
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
}

const { light, dark, alt } = Astro.props;
---

<div class="theme-diagram">
  <img class="theme-diagram-light" src={light.src} alt={alt} width={light.width} height={light.height} loading="lazy" decoding="async" />
  <img class="theme-diagram-dark" src={dark.src} alt={alt} width={dark.width} height={dark.height} loading="lazy" decoding="async" />
</div>
