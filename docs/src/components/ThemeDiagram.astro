---
/**
 * ThemeDiagram — renders a diagram SVG. The docs are dark-only (Dispatch
 * Console theme), so there is a single console-themed variant.
 *
 * Usage:
 *   import ThemeDiagram from '../../components/ThemeDiagram.astro';
 *   <ThemeDiagram src={diagramSvg} alt="Description" />
 */
interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="theme-diagram">
  <img src={src.src} alt={alt} width={src.width} height={src.height} loading="lazy" decoding="async" />
</div>
