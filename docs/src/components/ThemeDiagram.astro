---
/**
 * ThemeDiagram — renders light and dark SVG variants, swapping on Starlight's theme toggle.
 *
 * Usage:
 *   import ThemeDiagram from '../../components/ThemeDiagram.astro';
 *   <ThemeDiagram light={lightSvg} dark={darkSvg} alt="Description" />
 */
interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
}

const { light, dark, alt } = Astro.props;
---

<div class="theme-diagram">
  <img src={light.src} alt={alt} class="theme-diagram-light" width={light.width} height={light.height} loading="lazy" decoding="async" />
  <img src={dark.src} alt={alt} class="theme-diagram-dark" width={dark.width} height={dark.height} loading="lazy" decoding="async" />
</div>
