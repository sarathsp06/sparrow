---
// Share controls for a post: native share sheet where the browser has one,
// copy link, and plain intent links for X, Bluesky, LinkedIn, Hacker News
// and email. No third-party scripts, nothing loads from the networks.
interface Props {
  url: string;
  title: string;
  description?: string;
  compact?: boolean;
}
const { url, title, description = '', compact = false } = Astro.props;
const enc = encodeURIComponent;
const text = `${title} — Sparrow field notes`;
const links = [
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${enc(text)}&url=${enc(url)}`, icon: 'M18.2 2h3.4l-7.4 8.5L23 22h-6.8l-5.3-7-6.1 7H1.4l7.9-9.1L1 2h7l4.8 6.4L18.2 2Zm-1.2 18h1.9L7.1 3.9H5.1L17 20Z' },
  { name: 'Bluesky', href: `https://bsky.app/intent/compose?text=${enc(`${text} ${url}`)}`, icon: 'M12 10.8c-1.1-2.1-4-6-6.8-8C2.6 1 1.6 1.3 1 1.6.3 1.9 0 3 0 3.6c0 .7.4 5.6.6 6.4.9 2.7 3.9 3.7 6.7 3.4-4.1.6-7.7 2.1-3 7.4 5.2 5.4 7.1-1.2 7.7-4.6.6 3.4 2.5 9.9 7.6 4.6 4.8-5.3 1.3-6.8-2.8-7.4 2.8.3 5.8-.7 6.7-3.4.3-.8.6-5.7.6-6.4 0-.6-.3-1.7-1-2-.6-.3-1.6-.6-4.2 1.2-2.8 2-5.7 5.9-6.8 8Z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`, icon: 'M20.4 2H3.6C2.7 2 2 2.7 2 3.6v16.8c0 .9.7 1.6 1.6 1.6h16.8c.9 0 1.6-.7 1.6-1.6V3.6c0-.9-.7-1.6-1.6-1.6ZM8 19H5v-9h3v9ZM6.5 8.7a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4ZM19 19h-3v-4.4c0-1 0-2.4-1.5-2.4S12.8 13.4 12.8 14.5V19h-3v-9h2.9v1.2c.4-.8 1.4-1.5 2.8-1.5 3 0 3.5 2 3.5 4.5V19Z' },
  { name: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${enc(url)}&t=${enc(title)}`, icon: 'M2 2h20v20H2V2Zm9.1 11.3L7.4 6.5h2l2.6 5 2.6-5h2l-3.7 6.8v4.7h-1.8v-4.7Z' },
  { name: 'Email', href: `mailto:?subject=${enc(title)}&body=${enc(`${description}\n\n${url}`)}`, icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V18h16V7.4l-8 5.3-8-5.3ZM5.2 7l6.8 4.5L18.8 7H5.2Z' },
];
---

<div class:list={['fn-share', { 'fn-share--compact': compact }]} data-share-url={url} data-share-title={title} data-share-text={description}>
  <span class="fn-share-label">Share</span>
  <button type="button" class="fn-share-btn fn-share-native" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 14v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Share…</span>
  </button>
  <button type="button" class="fn-share-btn fn-share-copy" title="Copy link">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span data-copy-label>Copy link</span>
  </button>
  {links.map((l) => (
    <a class="fn-share-btn" href={l.href} target="_blank" rel="noopener noreferrer" title={`Share on ${l.name}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icon} fill="currentColor"/></svg>
      <span>{l.name}</span>
    </a>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.fn-share').forEach((bar) => {
    const url = bar.dataset.shareUrl ?? location.href;
    const title = bar.dataset.shareTitle ?? document.title;
    const text = bar.dataset.shareText ?? '';

    const native = bar.querySelector<HTMLButtonElement>('.fn-share-native');
    if (native && typeof navigator.share === 'function') {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ url, title, text }).catch(() => {}));
    }

    const copy = bar.querySelector<HTMLButtonElement>('.fn-share-copy');
    const label = copy?.querySelector<HTMLElement>('[data-copy-label]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = 'Copied';
        copy.classList.add('is-done');
        setTimeout(() => { if (label) label.textContent = 'Copy link'; copy.classList.remove('is-done'); }, 1800);
      } catch {
        prompt('Copy this link', url);
      }
    });
  });
</script>
