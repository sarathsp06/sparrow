---
import { ScalarComponent } from '@scalar/astro';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import SocialCard from '../../components/SocialCard.astro';
import faviconSrc from '../../assets/favicon.svg';

// The OpenAPI spec lives at <repo>/api/openapi.yaml, one level above the docs
// project root. Read it at build time so it stays in sync with no committed copy.
// src/pages/reference/api.astro -> ../../../../api/openapi.yaml == <repo>/api/openapi.yaml
const specPath = fileURLToPath(new URL('../../../../api/openapi.yaml', import.meta.url));
const spec = readFileSync(specPath, 'utf-8');
// Scalar renders in client mode so the page keeps this <head>; the default
// static mode emits a whole second document inside the body.
const title = 'Sparrow API Reference';
const description = 'Every Sparrow REST operation and field, rendered from the committed OpenAPI 3.1 spec.';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={faviconSrc.src} type="image/svg+xml" />
  <SocialCard title={title} description={description} />
</head>
<body>
  <ScalarComponent
    renderMode="client"
    configuration={{
      content: spec,
      title: 'Sparrow API',
      darkMode: false,
      hideDarkModeToggle: false,
    }}
  />
</body>
</html>
