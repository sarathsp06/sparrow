---
// Landing page — "Field Guide": DuckDB-style structure on paper canvas.
// Centered hero → card grid → code demo → pipeline → get started.
import '../styles/sparrow-tokens.css';
import faviconSrc from '../assets/favicon.svg';
const favicon = faviconSrc.src;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docsHome = `${base}getting-started/installation/`;
const quickstart = `${base}getting-started/quickstart/`;
const apiRef = `${base}reference/api/`;
const satellitesDocs = `${base}satellites/`;
const cliDocs = `${base}satellites/#cli`;
const recipesDocs = `${base}satellites/#recipes`;
const sourcesDocs = `${base}satellites/#sources`;
const sinksDocs = `${base}satellites/#sinks`;
const githubURL = 'https://github.com/sarathsp06/sparrow';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sparrow — Self-hosted webhook delivery</title>
  <meta name="description" content="Sparrow is an open-source webhook delivery server: at-least-once delivery, classified retries, dual signatures, and OpenTelemetry tracing. One Go binary, one PostgreSQL database." />
  <meta name="color-scheme" content="light" />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="alternate" type="text/markdown" href={`${base}llms.txt`} title="llms.txt" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>

<body class="sp">

  <!-- NAV -->
  <nav class="sp-nav">
    <div class="sp-w">
      <div class="sp-nav-inner">
        <a href={base} class="sp-logo">
          <img src={favicon} alt="" width="28" height="28" />
          <span>Sparrow</span>
        </a>
        <div class="sp-nav-links">
          <a href={docsHome}>Docs</a>
          <a href={satellitesDocs}>Satellites</a>
          <a href={apiRef}>API</a>
          <a href={`${base}reference/architecture/`}>Architecture</a>
          <a href={`${base}deployment/docker-compose/`}>Deploy</a>
        </div>
        <div class="sp-nav-end">
          <a href={githubURL} target="_blank" rel="noopener" class="sp-nav-gh" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href={docsHome} class="sp-btn">Get started<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>
    </div>
  </nav>

  <!-- HERO — centered, DuckDB-style -->
  <section class="sp-hero">
    <div class="sp-w">
      <h1>Webhook delivery<br/>you run yourself</h1>
      <p class="sp-hero-sub">
        Sparrow is an open-source webhook delivery server: at-least-once delivery,
        retries with error classification, dual signatures, and OpenTelemetry tracing.
        One Go binary. One PostgreSQL database.
      </p>
      <div class="sp-hero-actions">
        <a href={docsHome} class="sp-btn sp-btn-lg">Get started<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href={apiRef} class="sp-btn-ghost sp-btn-lg">API reference</a>
      </div>
      <div class="sp-hero-meta">
        <span class="sp-hero-meta-item">MIT licensed</span>
        <span class="sp-hero-meta-sep"></span>
        <span class="sp-hero-meta-item">Go + PostgreSQL</span>
        <span class="sp-hero-meta-sep"></span>
        <span class="sp-hero-meta-item">OpenAPI 3.1</span>
        <span class="sp-hero-meta-sep"></span>
        <span class="sp-hero-meta-item"><a href={`${base}llms.txt`}>llms.txt</a></span>
      </div>
    </div>
  </section>

  <!-- WHY — card grid -->
  <section class="sp-cards-section">
    <div class="sp-w">
      <div class="sp-cards">

        <a class="sp-card" href={`${base}getting-started/how-it-works/`}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M4 12a8 8 0 1 1 16 0 8 8 0 0 1-16 0Z"/><path d="m9 12 2 2 4-4"/></svg>
            <h3>Guaranteed delivery</h3>
          </div>
          <p>Events persist in PostgreSQL before fan-out begins. At-least-once delivery with exponential backoff, manual retry, and full event replay.</p>
          <span class="sp-card-link">How it works<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={`${base}reference/error-classification/`}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M3 6h18M3 12h18M3 18h18"/><path d="m7 3 -2 3 2 3M17 15l2 3-2 3"/></svg>
            <h3>Failures, classified</h3>
          </div>
          <p>Ten error categories separate what retries (5xx, timeouts, 429s, refused connections) from dead ends (4xx, DNS, TLS). You always know why a delivery failed.</p>
          <span class="sp-card-link">Error reference<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={apiRef}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M12 3 4 7v5c0 4.5 3.2 7.9 8 9 4.8-1.1 8-4.5 8-9V7l-8-4Z"/><path d="m9 12 2 2 4-4"/></svg>
            <h3>Secure by default</h3>
          </div>
          <p>HMAC-SHA256 and Ed25519 signatures on every delivery. Secrets envelope-encrypted at rest with AES-256-GCM. SSRF protection blocks private and metadata IPs.</p>
          <span class="sp-card-link">Webhook API<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={`${base}reference/architecture/`}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M3 3v18h18"/><path d="m7 14 4-4 3 3 5-6"/></svg>
            <h3>Observable</h3>
          </div>
          <p>OpenTelemetry traces propagate through every queue job. Structured logs and metrics export via OTLP. An embedded dashboard shows deliveries and per-webhook health.</p>
          <span class="sp-card-link">Architecture<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={docsHome}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg>
            <h3>One binary, one database</h3>
          </div>
          <p>No Redis, no Kafka, no sidecar queue. A single Go binary plus PostgreSQL; migrations run automatically on startup. The UI ships embedded in the binary.</p>
          <span class="sp-card-link">Install<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={githubURL} target="_blank" rel="noopener">
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg>
            <h3>Open source</h3>
          </div>
          <p>MIT-licensed and built in the open. The REST API is described by a committed OpenAPI 3.1 spec, so you can generate a client in any language.</p>
          <span class="sp-card-link">GitHub<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

      </div>
    </div>
  </section>

  <!-- DEMO — push an event -->
  <section class="sp-section">
    <div class="sp-w">
      <div class="sp-feature-row">
        <div class="sp-feature-text">
          <span class="sp-label">PUSH AN EVENT</span>
          <h2>One POST. Sparrow does the rest.</h2>
          <p>Push an event with an idempotency key and Sparrow validates it, persists it, and fans out to every matching subscription. Duplicate pushes are detected and returned as such.</p>
          <p>Each delivery arrives signed with both <code>HMAC-SHA256</code> and <code>Ed25519</code>, so consumers verify with a shared secret or a public key — whichever fits their trust model.</p>
          <a href={quickstart} class="sp-link">Quickstart<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <div class="sp-feature-visual">
          <div class="sp-terminal">
            <div class="sp-terminal-bar">
              <span class="sp-terminal-title">terminal</span>
            </div>
            <div class="sp-terminal-body">
              <code><span class="sp-t-muted">$</span> curl -X POST http://localhost:8080/v1/namespaces/payments/events \</code>
              <code>  <span class="sp-t-flag">-H</span> <span class="sp-t-str">"Content-Type: application/json"</span> \</code>
              <code>  <span class="sp-t-flag">-H</span> <span class="sp-t-str">"X-API-Key: sk_live_..."</span> \</code>
              <code>  <span class="sp-t-flag">-d</span> <span class="sp-t-str">'{`{`}</span></code>
              <code>    <span class="sp-t-key">"payload"</span>:         <span class="sp-t-str">'{`{`}"id":"inv_01","amount":4999{`}`}'</span>,</code>
              <code>    <span class="sp-t-key">"idempotency_key"</span>: <span class="sp-t-str">"idem_abc123"</span></code>
              <code>  <span class="sp-t-str">{`}`}'</span></code>
              <code></code>
              <code><span class="sp-t-muted">// 201 Created</span></code>
              <code>{`{`}</code>
              <code>  <span class="sp-t-key">"event_id"</span>:  <span class="sp-t-str">"evt_7f3a..."</span>,</code>
              <code>  <span class="sp-t-key">"duplicate"</span>: <span class="sp-t-bool">false</span></code>
              <code>{`}`}</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="sp-section sp-section-muted">
    <div class="sp-w">
      <div class="sp-feature-row sp-feature-row-reverse">
        <div class="sp-feature-text">
          <span class="sp-label">DELIVERY PIPELINE</span>
          <h2>Five stages, all in PostgreSQL</h2>
          <p>River workers drive the pipeline over the same database that stores your events. Fan-out matches subscriptions and applies per-subscription Go template transforms; delivery POSTs with signatures and per-webhook rate limits.</p>
          <p>When a delivery fails, the error is classified before anything else happens. Retryable failures back off exponentially; permanent ones stop immediately and mark webhook health.</p>
          <a href={`${base}getting-started/how-it-works/`} class="sp-link">How it works<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <div class="sp-feature-visual">
          <div class="sp-pipeline">
            <div class="sp-pipeline-step">
              <div class="sp-pipeline-num">01</div>
              <div class="sp-pipeline-content">
                <span class="sp-pipeline-name">Push event</span>
                <span class="sp-pipeline-desc">Validate, persist, dedup</span>
              </div>
            </div>
            <div class="sp-pipeline-line"></div>
            <div class="sp-pipeline-step">
              <div class="sp-pipeline-num">02</div>
              <div class="sp-pipeline-content">
                <span class="sp-pipeline-name">Fan-out</span>
                <span class="sp-pipeline-desc">Match subscriptions, transform</span>
              </div>
            </div>
            <div class="sp-pipeline-line"></div>
            <div class="sp-pipeline-step">
              <div class="sp-pipeline-num">03</div>
              <div class="sp-pipeline-content">
                <span class="sp-pipeline-name">Queue</span>
                <span class="sp-pipeline-desc">River workers, rate limiting</span>
              </div>
            </div>
            <div class="sp-pipeline-line"></div>
            <div class="sp-pipeline-step">
              <div class="sp-pipeline-num">04</div>
              <div class="sp-pipeline-content">
                <span class="sp-pipeline-name">Deliver</span>
                <span class="sp-pipeline-desc">HTTP POST, HMAC + Ed25519</span>
              </div>
            </div>
            <div class="sp-pipeline-line"></div>
            <div class="sp-pipeline-step">
              <div class="sp-pipeline-num">05</div>
              <div class="sp-pipeline-content">
                <span class="sp-pipeline-name">Retry</span>
                <span class="sp-pipeline-desc">Classify, backoff, health track</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SATELLITES -->
  <section class="sp-section">
    <div class="sp-w">
      <span class="sp-label">SATELLITES</span>
      <h2 class="sp-section-title">Satellites orbit the core — they never touch it</h2>
      <p class="sp-section-sub">Companion tools built entirely on the public REST API and signed-webhook contract. The core stays one small server; every satellite — including yours — inherits retries, signing, and the delivery audit trail. <a href={satellitesDocs}>How satellites work →</a></p>
      <div class="sp-cards sp-cards-4">

        <a class="sp-card" href={cliDocs}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="m4 17 6-5-6-5M12 19h8"/></svg>
            <h3>CLI</h3>
          </div>
          <p>Push events, tail deliveries, receive webhooks locally, and debug transform templates from your terminal.</p>
          <span class="sp-card-link">sparrow CLI<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={recipesDocs}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <h3>Recipes</h3>
          </div>
          <p>Slack, Discord, PagerDuty, ntfy, ClickHouse — adapters as config, applied with <code>sparrow use</code>. No glue service.</p>
          <span class="sp-card-link">Recipes<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={sourcesDocs}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            <h3>Sources</h3>
          </div>
          <p>Cron schedules plus Stripe and GitHub webhooks, verified and re-published as Sparrow events by <code>sparrow-sources</code>.</p>
          <span class="sp-card-link">Sources<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

        <a class="sp-card" href={sinksDocs}>
          <div class="sp-card-head">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            <h3>Sinks</h3>
          </div>
          <p>Signed deliveries forwarded out of HTTP land — SMTP email and S3/MinIO archives via <code>sparrow-sinks</code>.</p>
          <span class="sp-card-link">Sinks<svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>

      </div>
    </div>
  </section>

  <!-- GET STARTED -->
  <section class="sp-section">
    <div class="sp-w">
      <div class="sp-feature-row">
        <div class="sp-feature-text">
          <span class="sp-label">GET STARTED</span>
          <h2>Docker Compose to production</h2>
          <p>Two commands stand up Sparrow with PostgreSQL. For Kubernetes there is a Helm chart with hardened defaults: non-root, read-only root filesystem, NetworkPolicy isolation.</p>
          <div class="sp-hero-actions" style="margin-top:1.5rem">
            <a href={docsHome} class="sp-btn sp-btn-lg">Installation guide<svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
            <a href="https://railway.com/deploy/KzfSI3?referralCode=otXr-t&utm_medium=integration&utm_source=template&utm_campaign=generic" target="_blank" rel="noopener" class="sp-btn-ghost sp-btn-lg">Deploy on Railway</a>
          </div>
        </div>
        <div class="sp-feature-visual">
          <div class="sp-terminal sp-terminal-sm">
            <div class="sp-terminal-bar">
              <span class="sp-terminal-title">terminal</span>
            </div>
            <div class="sp-terminal-body">
              <code><span class="sp-t-muted">$</span> curl -O https://raw.githubusercontent.com/sarathsp06/sparrow/main/deploy/docker-compose.yml</code>
              <code></code>
              <code><span class="sp-t-muted">$</span> SPARROW_ENCRYPTION_KEY=<span class="sp-t-str">$(openssl rand -hex 32)</span> docker compose up <span class="sp-t-flag">-d</span></code>
              <code></code>
              <code><span class="sp-t-muted">Creating sparrow-postgres-1 ... done</span></code>
              <code><span class="sp-t-muted">Creating sparrow-sparrow-1  ... done</span></code>
              <code></code>
              <code><span class="sp-t-muted">$</span> open <span class="sp-t-str">http://localhost:8080</span></code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="sp-footer">
    <div class="sp-w">
      <div class="sp-footer-inner">
        <div class="sp-footer-col">
          <a href={base} class="sp-logo sp-logo-sm">
            <img src={favicon} alt="" width="18" height="18" />
            <span>Sparrow</span>
          </a>
          <p class="sp-footer-desc">Open-source webhook delivery infrastructure.</p>
        </div>
        <div class="sp-footer-col">
          <span class="sp-footer-heading">Product</span>
          <a href={docsHome}>Documentation</a>
          <a href={apiRef}>API Reference</a>
          <a href={quickstart}>Quickstart</a>
          <a href={satellitesDocs}>Satellites</a>
        </div>
        <div class="sp-footer-col">
          <span class="sp-footer-heading">Deploy</span>
          <a href={`${base}deployment/docker-compose/`}>Docker Compose</a>
          <a href={`${base}deployment/kubernetes/`}>Kubernetes</a>
          <a href={`${base}deployment/railway/`}>Railway</a>
        </div>
        <div class="sp-footer-col">
          <span class="sp-footer-heading">Resources</span>
          <a href={githubURL} target="_blank" rel="noopener">GitHub</a>
          <a href={`${base}reference/architecture/`}>Architecture</a>
          <a href={`${base}reference/error-classification/`}>Error Reference</a>
          <a href={`${base}llms.txt`}>llms.txt</a>
        </div>
      </div>
      <div class="sp-footer-bottom">
        <span>Open source under MIT license</span>
      </div>
    </div>
  </footer>
</body>
</html>

<style>
/* ================================================================
   Sparrow Landing — "Field Guide": light paper, single amber accent
   ================================================================ */

/* --- Reset / Base --- */
.sp {
  margin: 0; padding: 0;
  font-family: var(--sp-font-body);
  font-size: 15px;
  line-height: 1.5;
  color: var(--sp-on-surface);
  background: var(--sp-surface);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.sp *, .sp *::before, .sp *::after { box-sizing: border-box; }
.sp a { text-decoration: none; color: inherit; }
.sp code {
  font-family: var(--sp-font-mono);
  font-size: 13px;
}
.sp h1, .sp h2, .sp h3 { font-family: var(--sp-font-display); }

/* --- Layout --- */
.sp-w { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }

/* --- Nav --- */
.sp-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(250, 249, 247, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--sp-outline-variant);
}
.sp-nav-inner {
  display: flex; align-items: center; height: 3.5rem;
}
.sp-logo {
  display: flex; align-items: center; gap: 0.5rem;
}
.sp-logo span {
  font-family: var(--sp-font-display);
  font-weight: 700; font-size: 1rem; letter-spacing: -0.02em;
}
.sp-logo-sm span { font-size: 0.8125rem; }
.sp-nav-links {
  display: flex; align-items: center; gap: 1.5rem; margin-left: 2.5rem;
