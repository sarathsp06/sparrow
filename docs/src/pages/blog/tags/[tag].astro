---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { allTags, base, getPosts, tagSlug } from '../../../lib/blog/posts';

export async function getStaticPaths() {
  return allTags(await getPosts()).map(({ tag }) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props as { tag: string };
const posts = await getPosts();
const tagged = posts.filter((p) => p.tags.includes(tag));
---

<StarlightPage
  frontmatter={{
    // Field notes stay out of the docs search so stories don't crowd reference pages.
    pagefind: false,
    title: `Field notes on ${tag}`,
    description: `Sparrow field notes tagged “${tag}”.`,
    tableOfContents: false,
    prev: { link: `${base}blog/`, label: 'All field notes' },
    next: false,
  }}
>
  <p class="blog-standfirst">{tagged.length} {tagged.length === 1 ? 'note' : 'notes'} on this topic.</p>
  <BlogIndex posts={tagged} activeTag={tag} />
</StarlightPage>
