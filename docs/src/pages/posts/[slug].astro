---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { base, formatDate, getPosts, tagUrl } from '../../lib/blog/posts';
import { blogHead } from '../../lib/blog/head';
import '../../styles/blog.css';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.slug } }));
}

const posts = await getPosts();
const index = posts.findIndex((p) => p.slug === Astro.params.slug);
const post = posts[index];
const { frontmatter, headings, Content } = post;
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const date = new Date(frontmatter.pubDate);
const tags: string[] = (frontmatter.tags ?? []).map((t: string) => t.toLowerCase());
const site = Astro.site!;

const head = blogHead(site, base, {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: frontmatter.author ?? 'Sparrow team' },
  publisher: { '@type': 'Organization', name: 'Sparrow' },
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
}, [
  { tag: 'meta', attrs: { property: 'og:type', content: 'article' } },
  { tag: 'meta', attrs: { property: 'article:published_time', content: date.toISOString() } },
  ...tags.map((t) => ({ tag: 'meta' as const, attrs: { property: 'article:tag', content: t } })),
]);
---

<StarlightPage
  frontmatter={{
    title: frontmatter.title,
    description: frontmatter.description,
    head,
    prev: older ? { link: older.url, label: older.frontmatter.title } : false,
    next: newer ? { link: newer.url, label: newer.frontmatter.title } : false,
  }}
  headings={headings}
>
  <div class="blog-meta not-content">
    <a href={`${base}blog/`}>Field notes</a>
    {frontmatter.kicker && <span class="blog-kicker">{frontmatter.kicker}</span>}
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span>{post.minutes} min read</span>
  </div>
  {frontmatter.description && <p class="blog-standfirst">{frontmatter.description}</p>}
  <Content />
  <ul class="blog-tags not-content" aria-label="Tags">
    {tags.map((t) => <li><a href={tagUrl(t)}>{t}</a></li>)}
  </ul>
</StarlightPage>
