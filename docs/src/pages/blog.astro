---
import BlogLayout from '../layouts/BlogLayout.astro';
import BlogIndex from '../components/BlogIndex.astro';
import { getPosts, base } from '../lib/blog/posts';

const posts = await getPosts();
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Sparrow field notes',
  url: new URL(`${base}blog/`, site).href,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.frontmatter.title,
    datePublished: p.date.toISOString(),
    url: new URL(p.url, site).href,
  })),
};
---

<BlogLayout title="Field notes" description="Stories and engineering notes from the people building Sparrow, a self-hosted webhook delivery server." jsonLd={jsonLd}>
  <section class="blog-hero">
    <span class="eyebrow">Field notes</span>
    <h1>Small promises, kept carefully.</h1>
    <p>A webhook is a promise: when this happens, I will tell you. These are notes on what it takes to keep that promise, and on the people at either end of it.</p>
  </section>
  <BlogIndex posts={posts} featureFirst />
</BlogLayout>
