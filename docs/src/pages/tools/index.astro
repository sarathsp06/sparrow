---
import '../../styles/sparrow-tokens.css';
import faviconSrc from '../../assets/favicon.svg';
const favicon = faviconSrc.src;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docsHome = `${base}getting-started/installation/`;
const satellitesDocs = `${base}satellites/`;
const emailStudioUrl = `${base}tools/email-studio/`;
const recipeWorkbenchUrl = `${base}tools/recipe-workbench/`;
const githubURL = 'https://github.com/sarathsp06/sparrow';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sparrow Interactive Tools — Satellite Ecosystem Studio</title>
  <meta name="description" content="Interactive web applications for Sparrow satellite recipes, email template translation, schema verification, and previewing." />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>

<body class="sp">

  <!-- NAV -->
  <nav class="sp-nav">
    <div class="sp-w">
      <div class="sp-nav-inner">
        <a href={base} class="sp-logo">
          <img src={favicon} alt="" width="28" height="28" />
          <span>Sparrow Tools</span>
        </a>
        <div class="sp-nav-links">
          <a href={docsHome}>Docs</a>
          <a href={satellitesDocs}>Satellites</a>
          <a href={emailStudioUrl} class="sp-active">Email Studio</a>
          <a href={recipeWorkbenchUrl}>Recipe Workbench</a>
        </div>
        <div class="sp-nav-end">
          <a href={githubURL} target="_blank" rel="noopener" class="sp-nav-gh">
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="sp-hero">
    <div class="sp-w">
      <span class="sp-label">INTERACTIVE SATELLITE APPLICATIONS</span>
      <h1>Satellite Studio &amp; Tools</h1>
      <p class="sp-hero-sub">
        No-code interactive applications to design, verify, copy schemas, and preview how webhooks transform into emails, chat messages, and alerts in real time.
      </p>

      <div class="sp-cards sp-cards-2">
        <a class="sp-card" href={emailStudioUrl}>
          <div class="sp-card-head">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <h3>SendGrid Email Recipe Studio</h3>
          </div>
          <p>Create, verify, and preview email templates. Copy event schemas directly from your subscription setup, adjust parameters, and see how the rendered email looks in an interactive inbox preview.</p>
          <span class="sp-card-link">Launch Email Studio &rarr;</span>
        </a>

        <a class="sp-card" href={recipeWorkbenchUrl}>
          <div class="sp-card-head">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            <h3>Satellite Recipe Workbench</h3>
          </div>
          <p>Interactive workbench for all 7 satellite recipes (Slack, Discord, SendGrid, ntfy, PagerDuty, ClickHouse, Twilio). Test parameters and inspect live rendered outputs.</p>
          <span class="sp-card-link">Launch Recipe Workbench &rarr;</span>
        </a>
      </div>
    </div>
  </section>

</body>
</html>

<style>
.sp { margin: 0; padding: 0; font-family: var(--sp-font-body); background: var(--sp-surface); color: var(--sp-on-surface); }
.sp-w { max-width: 1120px; margin: 0 auto; padding: 0 1.5rem; }
.sp-nav { height: 3.5rem; border-bottom: 1px solid var(--sp-outline-variant); background: var(--sp-surface); }
.sp-nav-inner { display: flex; align-items: center; height: 100%; justify-content: space-between; }
.sp-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; font-weight: 700; color: inherit; }
.sp-nav-links { display: flex; gap: 1.5rem; }
.sp-nav-links a { text-decoration: none; color: var(--sp-on-surface-variant); font-size: 14px; font-weight: 500; }
.sp-nav-links a.sp-active { color: var(--sp-brand-primary-text, #b06a10); font-weight: 700; }
.sp-hero { padding: 4rem 0; text-align: center; }
.sp-label { font-family: var(--sp-font-mono); font-size: 11px; font-weight: 700; color: #b06a10; letter-spacing: 0.05em; }
.sp-hero h1 { font-size: 2.5rem; font-weight: 700; margin: 0.5rem 0 1rem; }
.sp-hero-sub { font-size: 1.1rem; color: #4b5563; max-width: 42rem; margin: 0 auto 3rem; }
.sp-cards-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; text-align: left; }
@media (max-width: 768px) { .sp-cards-2 { grid-template-columns: 1fr; } }
.sp-card { display: flex; flex-direction: column; padding: 1.5rem; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; text-decoration: none; color: inherit; transition: border-color 0.15s; }
.sp-card:hover { border-color: #f59e0b; }
.sp-card-head { display: flex; align-items: center; gap: 0.75rem; color: #b06a10; }
.sp-card-head h3 { margin: 0; font-size: 1.2rem; color: #111827; }
.sp-card p { margin: 1rem 0; font-size: 0.9rem; color: #4b5563; line-height: 1.6; flex: 1; }
.sp-card-link { font-size: 0.9rem; font-weight: 700; color: #b06a10; }
</style>
