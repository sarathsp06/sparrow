---
import RecipeWorkbenchApp from '../../components/tools/RecipeWorkbenchApp.svelte';
import '../../styles/sparrow-tokens.css';
import '../../styles/custom.css';
import faviconSrc from '../../assets/favicon.svg';

const favicon = faviconSrc.src;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docsHome = `${base}getting-started/installation/`;
const satellitesDocs = `${base}satellites/`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Recipe workbench — Sparrow</title>
  <meta name="description" content="Paste a Sparrow transform template and see what Slack, email, SMS, Discord, ntfy, PagerDuty or ClickHouse receives." />
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>

<body class="sp">
  <!-- NAV -->
  <nav class="sp-nav">
    <div class="sp-w">
      <div class="sp-nav-inner">
        <a href={base} class="sp-logo">
          <img src={favicon} alt="Sparrow Logo" width="28" height="28" />
          <span>Sparrow</span>
        </a>
        <div class="sp-nav-links">
          <a href={docsHome}>Docs</a>
          <a href={satellitesDocs}>Satellites</a>
          <a href={`${base}tools/recipe-workbench/`} class="sp-active">Recipe workbench</a>
        </div>
      </div>
    </div>
  </nav>

  <main class="sp-w">
    <RecipeWorkbenchApp client:load />
  </main>
</body>
</html>

<style>
.sp { margin: 0; padding: 0; font-family: var(--sp-font-body, system-ui, sans-serif); background: var(--sp-surface, #faf9f7); color: var(--sp-on-surface, #1a1a1a); }
.sp-w { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
@media (max-width: 600px) { .sp-w { padding: 0 1rem; } }
.sp-nav { min-height: 3.5rem; border-bottom: 1px solid var(--sp-outline-variant, #e4e2dd); background: var(--sp-surface-container-lowest, #fff); }
.sp-nav-inner { display: flex; align-items: center; min-height: 3.5rem; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.5rem 0; }
.sp-logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; font-family: var(--sp-font-display, system-ui, sans-serif); font-weight: 600; color: inherit; }
.sp-nav-links { display: flex; gap: 1.5rem; }
.sp-nav-links a { text-decoration: none; color: var(--sp-on-surface-variant, #55524c); font-size: 14px; font-weight: 500; white-space: nowrap; }
@media (max-width: 600px) { .sp-nav-links { gap: 1rem; } .sp-nav-links a { font-size: 13px; } }
.sp-nav-links a:hover { color: var(--sp-on-surface, #1a1a1a); }
.sp-nav-links a.sp-active { color: var(--sp-primary, #b06a10); }
.sp-nav-links a:focus-visible { outline: 2px solid var(--sp-primary-container, #f2a93b); outline-offset: 3px; }
</style>
