flowchart TD
    A["Register, PATCH, import, or auto-register"] --> R{"name starts with sparrow. ?"}
    R -- "yes, from a user" --> RJ["400: reserved for Sparrow's own events"]
    R -- no --> L["Lock the current row"]
    L --> E{"exists?"}
    E -- no --> C["created: v1 + history row"]
    E -- yes --> S{"current has no schema,<br>new one has a schema?"}
    S -- yes --> F["updated in place:<br>fill in v1, set schema_defined_at"]
    S -- no --> D{"schema differs by value?"}
    D -- no --> M{"description, metadata<br>or active differ?"}
    M -- yes --> U["updated in place, same version"]
    M -- no --> N["unchanged: nothing written"]
    D -- yes --> K["classify from the subscribers' side"]
    K --> B{"breaking, and subscriptions<br>receive this type?"}
    B -- "yes, no allow_breaking" --> X["409: nothing written, reasons listed"]
    B -- otherwise --> V["new_version: bump, keep old version,<br>regenerate sample payload"]
