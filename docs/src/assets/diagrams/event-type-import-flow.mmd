flowchart LR
    F["bundle file"] --> V["validate every item:<br>names, duplicates, sparrow.*,<br>schemas compile, 500 items"]
    V --> ST["check the stamp:<br>version, format, sha256"]
    ST --> TX["one transaction,<br>items locked by name"]
    TX --> W["save each item<br>(usual version rules)"]
    W --> CK["new versions: render every affected<br>template strictly, full and<br>required-only payloads"]
    CK --> G{"dry run, unacknowledged<br>stamp warning, or breaking<br>without allow_breaking?"}
    G -- yes --> RB["roll back; return the full<br>result and blocked_by"]
    G -- no --> P{"subscription_policy = pause?"}
    P -- yes --> PA["pause subscriptions whose<br>template failed"]
    P -- no --> CM["commit; return results<br>and imported_at"]
    PA --> CM
