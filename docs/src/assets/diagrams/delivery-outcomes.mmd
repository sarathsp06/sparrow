flowchart TD
    E["event accepted,<br>event_version recorded"] --> FO["fan-out to matching subscriptions"]
    FO --> PS{"webhook or subscription paused?<br>(incl. auto-disabled)"}
    PS -- yes --> PR["delivery row, status paused,<br>no job queued"]
    PR -. "resume, then retry" .-> JOB
    PS -- no --> JOB["delivery row pending,<br>job queued"]
    JOB --> HP{"paused since queued?"}
    HP -- yes --> PR
    HP -- no --> T{"transform enabled?"}
    T -- no --> ENV["default envelope"]
    T -- yes --> RN["render template<br>(template_missing_key)"]
    RN --> OK{"rendered?"}
    OK -- yes --> SEND["HTTP request"]
    OK -- no --> OE{"on_transform_error"}
    OE -- fail --> TE["failed, template_error:<br>not retried automatically"]
    TE -. "fix template, retry" .-> JOB
    OE -- fallback --> ENV2["default envelope,<br>template_error recorded"]
    ENV --> SEND
    ENV2 --> SEND
    SEND --> RES{"response"}
    RES -- "expected 2xx" --> S["success"]
    RES -- retryable --> RT["retry with backoff"]
    RES -- permanent --> FL["failed"]
    S --> H[("webhook health")]
    RT --> H
    FL --> H
    H -. "failing for SPARROW_AUTO_DISABLE_AFTER" .-> AD["webhook auto-disabled<br>(sparrow.webhook.disabled)"]
