        "note": "Register a webhook with its event types; Sparrow creates subscriptions and returns the signing secret once."
      },
      {
        "id": "push",
        "label": "2 · Push",
        "focus": [
          "client",
          "api",
          "svc",
          "pg",
          "workers"
        ],
        "note": "Push an event with an idempotency key; it persists in PostgreSQL, then fan-out enqueues one delivery per matching subscription."
      },
      {
        "id": "deliver",
        "label": "3 · Deliver",
        "focus": [
          "pg",
          "workers",
          "signer",
          "endpoint"
        ],
        "note": "Workers drain the queue; deliveries are signed (HMAC + Ed25519), POSTed, and retried with backoff on classified failures."
      }
    ]
  },
