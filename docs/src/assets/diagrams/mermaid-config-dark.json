{
  "theme": "dark",
  "themeVariables": {
    "fontFamily": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
    "fontSize": "14px",
    "primaryColor": "#121a2a",
    "primaryTextColor": "#e6ecf5",
    "primaryBorderColor": "#33456a",
    "lineColor": "#8494b0",
    "secondaryColor": "#0f1626",
    "tertiaryColor": "#16223a",
    "noteBkgColor": "#16223a",
    "noteTextColor": "#b8c2d6",
    "nodeBorder": "#33456a",
    "clusterBkg": "#0b1220",
    "clusterBorder": "#24304a",
    "edgeLabelBackground": "#0b1220"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "basis",
    "padding": 16,
    "nodeSpacing": 50,
    "rankSpacing": 60
  },
  "state": {
    "textColor": "#e6ecf5",
    "dividerColor": "#24304a"
  }
}
