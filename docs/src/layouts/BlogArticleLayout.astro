---
import BlogLayout from './BlogLayout.astro';
import { base, findPost, formatDate, getPosts, tagUrl } from '../lib/blog/posts';

const { frontmatter, url } = Astro.props;
const posts = await getPosts();
const index = findPost(posts, url);
const post = posts[index];
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const date = new Date(frontmatter.pubDate);
const tags: string[] = (frontmatter.tags ?? []).map((t: string) => t.toLowerCase());
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: frontmatter.author ?? 'Sparrow team' },
  publisher: { '@type': 'Organization', name: 'Sparrow' },
  keywords: tags.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
};
---

<BlogLayout title={frontmatter.title} description={frontmatter.description} type="article" jsonLd={jsonLd} publishedTime={date.toISOString()} tags={tags}>
  <article class="article">
    <header class="article-head">
      <a class="eyebrow" href={`${base}blog/`}>← Field notes</a>
      {frontmatter.kicker && <p class="article-kicker">{frontmatter.kicker}</p>}
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="article-standfirst">{frontmatter.description}</p>}
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {post && <span>{post.minutes} min read</span>}
        {frontmatter.author && <span>{frontmatter.author}</span>}
      </div>
    </header>
    <div class="post-content"><slot /></div>
    <footer class="article-foot">
      <ul class="tag-list" aria-label="Tags">
        {tags.map((t) => <li><a href={tagUrl(t)}>{t}</a></li>)}
      </ul>
      {(older || newer) && (
        <nav class="article-pager" aria-label="More field notes">
          {older ? <a href={older.url} rel="prev"><span>Earlier</span>{older.frontmatter.title}</a> : <span />}
          {newer && <a href={newer.url} rel="next" class="next"><span>Later</span>{newer.frontmatter.title}</a>}
        </nav>
      )}
    </footer>
  </article>
</BlogLayout>
