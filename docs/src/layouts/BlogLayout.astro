---
import faviconSrc from '../assets/favicon.svg';
import '../styles/blog.css';
import { base } from '../lib/blog/posts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  publishedTime?: string;
  tags?: string[];
}

const { title, description = 'Field notes from the people building Sparrow.', type = 'website', jsonLd, publishedTime, tags = [] } = Astro.props;
const favicon = faviconSrc.src;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const rss = new URL(`${base}blog/rss.xml`, Astro.site).href;
const fullTitle = `${title} · Sparrow`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Code blocks pick their light/dark syntax theme from data-theme, as on the docs pages.
      (() => {
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const set = () => { document.documentElement.dataset.theme = mq.matches ? 'dark' : 'light'; };
        set();
        mq.addEventListener('change', set);
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Sparrow field notes" href={rss} />
    <meta property="og:site_name" content="Sparrow" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Fira+Code:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="blog-header">
      <a class="blog-brand" href={base}>
        <img src={favicon} alt="" width="28" height="28" />
        <span>Sparrow</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={`${base}getting-started/installation/`}>Docs</a>
        <a href={`${base}blog/`} aria-current={Astro.url.pathname.includes('/blog') || Astro.url.pathname.includes('/posts/') ? 'page' : undefined}>Field notes</a>
        <a href="https://github.com/sarathsp06/sparrow">GitHub</a>
      </nav>
    </header>

    <main id="main" class="blog-shell">
      <slot />
    </main>

    <footer class="blog-footer">
      <a href={base}>Sparrow</a>
      <span>Self-hosted webhook delivery, written about by the people who build it.</span>
      <a class="blog-footer-rss" href={`${base}blog/rss.xml`}>RSS</a>
    </footer>
  </body>
</html>
