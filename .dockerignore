# Git
.git
.gitignore
.github/

# Documentation (not needed for build)
docs/

# Prebuilt binaries (we compile in Docker)
build/
# Top-level dist only; internal/ui/dist is needed for go:embed
/dist/
*.exe
*.dll
*.so
*.dylib
cmd/server/server
migrate
server-*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.bak

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment files
.env
.env.*
!.env.example

# Docker files (prevent recursive context)
Dockerfile*
.dockerignore
docker-compose*.yml


# Agent tooling: .claude/worktrees holds full checkouts of the repo (GBs)
.claude/
graphify-out/
okf/

# Not part of the server build: e2e suite, generated clients, other satellites
e2e/
client/
satellites/sparrow/
satellites/sparrow-sinks/

# Dependencies anywhere (installed fresh in Docker)
**/node_modules/
**/.venv/
web/.svelte-kit/

# Test coverage
coverage.out
coverage.html
testdata/
