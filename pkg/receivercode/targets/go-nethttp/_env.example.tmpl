# [[.Header]]
[[- if .Ed25519]]

# Deliveries are verified with this webhook's Ed25519 public key, embedded in
# receiver.go. Set this only to use a different key.
# [[.EnvPublicKey]]=
[[- else]]

# The webhook's signing secret (whsec_...), from Sparrow. Never commit it.
[[.EnvSecret]]=
[[- end]]

PORT=[[.Port]]

# 1 writes one JSON line per handler call to stdout (for contract tests).
[[.EnvTestMode]]=0
