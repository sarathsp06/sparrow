// [[.Header]]

package main

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"os"
	"strings"
	"testing"
	"time"
)

// spec is testdata/spec.json: the receiver spec and its test vectors,
// signed with throwaway credentials (never the webhook's real secret).
type spec struct {
	Test struct {
		Now       int64  `json:"now"`
		Secret    string `json:"secret"`
		PublicKey string `json:"public_key"`
	} `json:"test"`
	Vectors []struct {
		Name    string            `json:"name"`
		Headers map[string]string `json:"headers"`
		Body    string            `json:"body"`
		Expect  struct {
			Status  int             `json:"status"`
			Handler string          `json:"handler"`
			Value   json.RawMessage `json:"value"`
			Match   string          `json:"match"`
		} `json:"expect"`
	} `json:"vectors"`
}

// TestVectors replays every vector, in order, against one receiver.
func TestVectors(t *testing.T) {
	raw, err := os.ReadFile("testdata/spec.json")
	if err != nil {
		t.Fatal(err)
	}
	var s spec
	if err := json.Unmarshal(raw, &s); err != nil {
		t.Fatal(err)
	}

	var log bytes.Buffer
	rc := NewReceiver(Config{
[[- if .Ed25519]]
		PublicKey: s.Test.PublicKey,
[[- else]]
		Secret: s.Test.Secret,
[[- end]]
		Now:     func() time.Time { return time.Unix(s.Test.Now, 0) },
		TestLog: &log,
	})

	for _, v := range s.Vectors {
		before := log.Len()
		req := httptest.NewRequest(http.MethodPost, "[[.WebhookPath]]", strings.NewReader(v.Body))
		for k, val := range v.Headers {
			req.Header.Set(k, val)
		}
		rec := httptest.NewRecorder()
		rc.ServeHTTP(rec, req)

		if rec.Code != v.Expect.Status {
			t.Errorf("%s: status %d, want %d (%s)", v.Name, rec.Code, v.Expect.Status, rec.Body)
			continue
		}
		calls := strings.TrimSpace(log.String()[before:])
		if v.Expect.Handler == "" {
			if calls != "" {
				t.Errorf("%s: handler called, want none: %s", v.Name, calls)
			}
			continue
		}
		var call struct {
			Handler string          `json:"handler"`
			Value   json.RawMessage `json:"value"`
		}
		if err := json.Unmarshal([]byte(calls), &call); err != nil {
			t.Errorf("%s: test log %q: %v", v.Name, calls, err)
			continue
		}
		if call.Handler != v.Expect.Handler {
			t.Errorf("%s: handler %q, want %q", v.Name, call.Handler, v.Expect.Handler)
		}
		if !matches(t, v.Expect.Value, call.Value, v.Expect.Match) {
			t.Errorf("%s: handler got %s, want %s (%s)", v.Name, call.Value, v.Expect.Value, v.Expect.Match)
		}
	}
}

func TestHealthz(t *testing.T) {
	rec := httptest.NewRecorder()
	NewReceiver(Config{}).ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "[[.HealthPath]]", nil))
	if rec.Code != http.StatusOK {
		t.Fatalf("healthz = %d", rec.Code)
	}
}

// matches compares JSON values: "equal", or "subset" (every value in want
// is in got).
func matches(t *testing.T, want, got json.RawMessage, mode string) bool {
	t.Helper()
	var w, g any
	if json.Unmarshal(want, &w) != nil || json.Unmarshal(got, &g) != nil {
		return false
	}
	if mode == "equal" {
		return jsonEqual(w, g)
	}
	return subset(w, g)
}

func subset(want, got any) bool {
	switch w := want.(type) {
	case map[string]any:
		g, ok := got.(map[string]any)
		if !ok {
			return false
		}
		for k, wv := range w {
			if !subset(wv, g[k]) {
				return false
			}
		}
		return true
	case []any:
		g, ok := got.([]any)
		if !ok || len(g) != len(w) {
			return false
		}
		for i := range w {
			if !subset(w[i], g[i]) {
				return false
			}
		}
		return true
	}
	return jsonEqual(want, got)
}

func jsonEqual(a, b any) bool {
	x, _ := json.Marshal(a)
	y, _ := json.Marshal(b)
	return bytes.Equal(x, y)
}
