// [[.Header]]

// Command sparrow-receiver receives Sparrow webhook deliveries for webhook
// [[.WebhookID]].
package main

import (
	"log"
	"net/http"
	"os"
	"time"
)

func main() {
	cfg, err := ConfigFromEnv()
	if err != nil {
		log.Fatal(err)
	}
	port := os.Getenv("PORT")
	if port == "" {
		port = "[[.Port]]"
	}
	srv := &http.Server{
		Addr:              ":" + port,
		Handler:           NewReceiver(cfg),
		ReadHeaderTimeout: 10 * time.Second,
	}
	log.Printf("sparrow-receiver listening on :%s", port)
	log.Fatal(srv.ListenAndServe())
}
