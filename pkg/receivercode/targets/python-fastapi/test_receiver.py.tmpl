# [[.Header]]
"""Replays testdata/spec.json against the receiver.

The vectors are signed with throwaway credentials, never the webhook's real
[[if .Ed25519]]key[[else]]secret[[end]].
"""

import io
import json
from pathlib import Path

from fastapi.testclient import TestClient

from receiver import Config, create_app

SPEC = json.loads((Path(__file__).parent / "testdata" / "spec.json").read_text())


def _subset(want, got) -> bool:
    if isinstance(want, dict):
        return isinstance(got, dict) and all(_subset(v, got.get(k)) for k, v in want.items())
    if isinstance(want, list):
        return isinstance(got, list) and len(want) == len(got) and all(_subset(w, g) for w, g in zip(want, got))
    return _equal(want, got)


def _equal(want, got) -> bool:
    if isinstance(want, bool) or isinstance(got, bool):
        return want is got
    if isinstance(want, (int, float)) and isinstance(got, (int, float)):
        return float(want) == float(got)
    return want == got


def test_vectors() -> None:
    log = io.StringIO()
    test = SPEC["test"]
    cfg = Config([[if .Ed25519]]public_key=test["public_key"][[else]]secret=test["secret"][[end]], now=lambda: test["now"], test_log=log)
    client = TestClient(create_app(cfg))

    for v in SPEC["vectors"]:
        before = len(log.getvalue())
        resp = client.post("[[.WebhookPath]]", content=v["body"].encode(), headers=v["headers"])
        expect = v["expect"]
        assert resp.status_code == expect["status"], f'{v["name"]}: {resp.status_code} {resp.text}'

        calls = log.getvalue()[before:].strip()
        if not expect["handler"]:
            assert calls == "", f'{v["name"]}: handler called: {calls}'
            continue
        call = json.loads(calls)
        assert call["handler"] == expect["handler"], v["name"]
        if expect["match"] == "equal":
            assert _equal(expect["value"], call["value"]), f'{v["name"]}: {call["value"]!r}'
        else:
            assert _subset(expect["value"], call["value"]), f'{v["name"]}: {call["value"]!r}'


def test_healthz() -> None:
    cfg = Config([[if .Ed25519]]public_key=SPEC["test"]["public_key"][[else]]secret=SPEC["test"]["secret"][[end]])
    assert TestClient(create_app(cfg)).get("[[.HealthPath]]").status_code == 200
